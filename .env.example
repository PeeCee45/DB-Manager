# Application Database (MySQL)
APP_DB_HOST=localhost
APP_DB_PORT=3306
APP_DB_NAME=db_manager
APP_DB_USER=root
APP_DB_PASSWORD=your_password\
APP_DB_SSL=false

# Encryption key for external DB passwords (generate a strong 32-char key)
DATABASE_ENCRYPTION_KEY=your-32-character-encryption-key-here!!

# Session secret for JWT signing (generate a strong random string)
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

